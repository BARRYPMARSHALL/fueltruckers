# ─── FuelTruckers environment variables ───────────────────────────────────
# Copy to .env and fill in. NEVER commit .env.
# The app runs in a full "demo mode" with realistic mock data even when these
# are unset, so you can try it immediately without any accounts.

# ── Supabase (Auth + Postgres + Storage + Realtime) ──
# Project → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Stripe (subscription checkout — PLACEHOLDER keys in test mode) ──
# Get test keys from https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=
# The Price ID for the $30/mo subscription (Stripe Dashboard → Products,
# recurring monthly, AUD, unit_amount 3000). Optional for demo.
VITE_STRIPE_PRICE_ID=
